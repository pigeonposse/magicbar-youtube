	"type": "module",
	"scripts": {
		"build": "pnpm build:firefox && pnpm build:chrome && pnpm build:bepp",
		"build:firefox": "TARGET=firefox vite build",
		"build:chrome": "TARGET=chrome vite build",
		"build:bepp": "bepp build --time -c .dovenv/bepp.config.yml",
		"dev": "pnpm dev:chrome",
		"dev:chrome": "TARGET=chrome vite dev",
		"dev:firefox": "TARGET=firefox vite dev",
		"lint": "oxlint",
		"push-main": "git add . && git commit -m '@1' && git push -u origin main",
		"lint:fix": "oxlint --fix",
		"release": "release-it"
	},
	"devDependencies": {
		"@bepp/bepp": "1.3.17",
		"@release-it/bumper": "8.0.1",
		"auto-changelog": "~2.7.0",
		"oxlint": "1.90.0",
		"release-it": "21.1.2",
		"vite": "~8.3.5",
		"vite-plugin-web-extension": "~4.5.1"
	},
	"packageManager": "pnpm@12.16.1",
