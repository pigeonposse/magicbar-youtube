{
  "manifest_version": 3,
  "name": "MagicBar for YouTube",
  "version": "1.0.3",
  "description": "Turn the YouTube search bar into a panel featuring your recent searches, latest videos, and most-watched channels.",
  "browser_specific_settings": {
    "gecko": {
      "id": "magicbar-yt@pigeonposse.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://suggestqueries.google.com/*",
    "https://trends.google.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "/icon-16.png",
    "32": "/icon-32.png",
    "48": "/icon-48.png",
    "128": "/icon-128.png"
  },
  "action": {
    "default_title": "MagicBar for YouTube",
    "default_icon": {
      "16": "/icon-16.png",
      "32": "/icon-32.png",
      "48": "/icon-48.png"
    }
  }
}
